---
import Layout from '../../../layouts/Layout.astro';
import { supabase } from '../../../lib/supabase';

const { slug } = Astro.params;

const { data: vacancy } = await supabase
  .from('vacancies')
  .select('*')
  .eq('slug', slug)
  .eq('is_active', true)
  .single();

if (!vacancy) {
  return Astro.redirect('/404');
}

const employmentLabels: Record<string, string> = {
  full_time: 'Fulltime',
  part_time: 'Parttime',
  temporary: 'Tijdelijk',
  internship: 'Stage',
  freelance: 'Freelance',
};

const formatHours = (min?: number | null, max?: number | null) => {
  if (min == null && max == null) return '';
  if (min != null && max != null && min !== max) return `${min}-${max} uur`;
  const value = min ?? max ?? 0;
  return `${value} uur`;
};

---

<Layout title={`${vacancy.title} | Vacatures`}>
  <section class="pt-40 pb-20 bg-ivory">
    <div class="container mx-auto px-6 max-w-6xl">
      <nav class="flex items-center gap-2 text-[10px] tracking-[0.2em] uppercase text-taupe font-body mb-8 flex-wrap">
        <a href="/" class="hover:text-charcoal transition-colors">Home</a>
        <span class="text-champagne">›</span>
        <a href="/over-ons/vacatures/" class="hover:text-charcoal transition-colors">Vacatures</a>
        <span class="text-champagne">›</span>
        <span class="text-blush-deep">{vacancy.title}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-10 lg:gap-16 items-start">
        <div>
          <p class="text-[10px] tracking-[0.4em] uppercase text-blush-deep font-body mb-5">
            {vacancy.department || 'Vacature'}
          </p>
          <h1 class="font-display text-charcoal leading-[0.98] mb-6" style="font-size: clamp(42px, 6vw, 76px);">
            {vacancy.title}
          </h1>
          <div class="flex flex-wrap gap-2 mb-8 text-[9px] uppercase tracking-[0.18em]">
            {vacancy.employment_type && (
              <span class="inline-flex items-center rounded-full border border-blush-deep/15 bg-white px-3 py-1 text-taupe">
                {employmentLabels[vacancy.employment_type] ?? vacancy.employment_type}
              </span>
            )}
            {vacancy.location && (
              <span class="inline-flex items-center rounded-full border border-blush-deep/15 bg-white px-3 py-1 text-taupe">
                {vacancy.location}
              </span>
            )}
            {formatHours(vacancy.hours_min, vacancy.hours_max) && (
              <span class="inline-flex items-center rounded-full border border-blush-deep/15 bg-white px-3 py-1 text-taupe">
                {formatHours(vacancy.hours_min, vacancy.hours_max)}
              </span>
            )}
          </div>

          {vacancy.summary && <p class="text-taupe font-light text-lg leading-relaxed mb-8 max-w-3xl">{vacancy.summary}</p>}
          {vacancy.description && <p class="text-taupe font-light leading-relaxed whitespace-pre-line max-w-3xl">{vacancy.description}</p>}
        </div>

        <aside class="bg-white border border-champagne rounded-[28px] p-6 md:p-8 shadow-soft sticky top-28">
          <p class="text-[10px] tracking-[0.35em] uppercase text-blush-deep font-body mb-4">Solliciteren</p>
          <h2 class="font-display text-charcoal text-3xl mb-4">Stuur je <em class="italic font-light text-taupe">sollicitatie</em></h2>
          <p class="text-taupe font-light leading-relaxed mb-8">
            Vul je gegevens in en verstuur direct je motivatie. We ontvangen je sollicitatie meteen in de backend.
          </p>

          <form id="vacancy-application-form" action="/api/vacancies/apply" method="post" class="space-y-4">
            <input type="hidden" name="vacancy_id" value={vacancy.id} />
            <input type="hidden" name="vacancy_slug" value={vacancy.slug} />
            <input type="text" name="_hp" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

            <div>
              <label for="full_name" class="block text-[10px] tracking-[0.18em] uppercase text-taupe font-body mb-2">Naam *</label>
              <input id="full_name" name="full_name" required class="w-full rounded-2xl border border-champagne bg-ivory/60 px-4 py-3 text-sm text-charcoal placeholder:text-taupe/50 focus:border-blush-deep focus:outline-none" placeholder="Je volledige naam" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="email" class="block text-[10px] tracking-[0.18em] uppercase text-taupe font-body mb-2">E-mail *</label>
                <input id="email" name="email" type="email" required class="w-full rounded-2xl border border-champagne bg-ivory/60 px-4 py-3 text-sm text-charcoal placeholder:text-taupe/50 focus:border-blush-deep focus:outline-none" placeholder="naam@email.nl" />
              </div>
              <div>
                <label for="phone" class="block text-[10px] tracking-[0.18em] uppercase text-taupe font-body mb-2">Telefoon</label>
                <input id="phone" name="phone" type="tel" class="w-full rounded-2xl border border-champagne bg-ivory/60 px-4 py-3 text-sm text-charcoal placeholder:text-taupe/50 focus:border-blush-deep focus:outline-none" placeholder="06..." />
              </div>
            </div>

            <div>
              <label for="linkedin_url" class="block text-[10px] tracking-[0.18em] uppercase text-taupe font-body mb-2">LinkedIn of portfolio</label>
              <input id="linkedin_url" name="linkedin_url" type="url" class="w-full rounded-2xl border border-champagne bg-ivory/60 px-4 py-3 text-sm text-charcoal placeholder:text-taupe/50 focus:border-blush-deep focus:outline-none" placeholder="https://..." />
            </div>

            <div>
              <label for="message" class="block text-[10px] tracking-[0.18em] uppercase text-taupe font-body mb-2">Motivatie *</label>
              <textarea id="message" name="message" rows="7" required class="w-full rounded-2xl border border-champagne bg-ivory/60 px-4 py-3 text-sm text-charcoal placeholder:text-taupe/50 focus:border-blush-deep focus:outline-none resize-y" placeholder="Vertel kort waarom je bij Mariage wilt werken en wat je meebrengt."></textarea>
            </div>

            <button type="submit" id="vacancy-application-submit" class="btn-blush w-full justify-center px-8 py-4">
              Sollicitatie versturen
            </button>

            <p id="vacancy-application-status" class="min-h-[1.25rem] text-sm text-taupe"></p>
          </form>

          <div class="mt-8 pt-6 border-t border-champagne text-sm text-taupe font-light space-y-3">
            {vacancy.application_email && <p>E-mail voor directe sollicitatie: <a href={`mailto:${vacancy.application_email}`} class="text-blush-deep hover:underline">{vacancy.application_email}</a></p>}
            {vacancy.application_url && (
              <p>Externe sollicitatie: <a href={vacancy.application_url} target="_blank" rel="noreferrer" class="text-blush-deep hover:underline">Open link</a></p>
            )}
            <p>Je sollicitatie komt direct in onze backend binnen en wordt ook per e-mail doorgestuurd.</p>
          </div>

          <div class="mt-6">
            <a href="/over-ons/vacatures/" class="btn-gold w-full justify-center px-8 py-4">
              Terug naar overzicht
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ vacancyId: vacancy.id, vacancySlug: vacancy.slug }}>
  const form = document.getElementById('vacancy-application-form');
  const submitButton = document.getElementById('vacancy-application-submit');
  const statusEl = document.getElementById('vacancy-application-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (submitButton) {
      submitButton.setAttribute('disabled', 'true');
      submitButton.textContent = 'Versturen...';
    }
    if (statusEl) statusEl.textContent = '';

    const formData = new FormData(form as HTMLFormElement);
    formData.set('vacancy_id', vacancyId);
    formData.set('vacancy_slug', vacancySlug);

    try {
      const response = await fetch('/api/vacancies/apply', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });

      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.error || 'Versturen mislukt');
      }

      (form as HTMLFormElement).reset();
      if (statusEl) {
        statusEl.textContent = 'Bedankt! Je sollicitatie is ontvangen.';
        statusEl.className = 'min-h-[1.25rem] text-sm text-green-700';
      }
    } catch (error) {
      if (statusEl) {
        statusEl.textContent = error instanceof Error ? error.message : 'Er ging iets mis.';
        statusEl.className = 'min-h-[1.25rem] text-sm text-red-500';
      }
    } finally {
      if (submitButton) {
        submitButton.removeAttribute('disabled');
        submitButton.textContent = 'Sollicitatie versturen';
      }
    }
  });
</script>
